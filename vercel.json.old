{
  "version": 2,
  "cleanUrls": true,
  "installCommand": "npm install && cd backend && npm install && npx prisma generate",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!assets|scripts|api|fontawesome-free-7.2.0-web|frontend).*)",
      "destination": "/frontend/$1"
    },
    {
      "source": "/",
      "destination": "/frontend/index.html"
    }
  ]
}
