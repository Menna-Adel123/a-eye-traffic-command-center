# AI model runtime
USE_CAMERA=true
CAMERA_SOURCE=1
VEHICLE_MODEL_PATH=models/yolov8n.pt
ACCIDENT_MODEL_PATH=models/best.pt
VIDEO_PATH=videos/acc_alex2.mp4
LOCATION_NAME=Alexandria - Corniche (Bibliotheca Area)
CAMERA_ID=Camera_01
LATITUDE=31.2156
LONGITUDE=29.9553

# Detection thresholds
PROTOTYPE_MODE=true
SNAP_COOLDOWN=10
CLIP_SECONDS_BEFORE=3
CLIP_SECONDS_AFTER=3
WEBHOOK_COOLDOWN=10
VEHICLE_CONFIDENCE=0.20
CONTACT_IOU_THRESHOLD=0.01
CONTACT_DISTANCE_THRESHOLD=45
REQUIRED_CONTACT_FRAMES=2
DIST_HIGH=25
DIST_MEDIUM=45
OUTPUT_DIR=accidents
CLIP_DIR=clips
LOG_DIR=logs

# Backend integration
BACKEND_WEBHOOK_URL=https://a-eye-traffic-command-center-ten.vercel.app/api/webhooks/ai-detection
AI_WEBHOOK_SECRET=change-this-shared-secret
WEBHOOK_TIMEOUT_SECONDS=5
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_BACKOFF_SECONDS=1
